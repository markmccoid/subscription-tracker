{
  "expo": {
    "name": "subscription-tracker",
    "slug": "subscription-tracker",
    "version": "1.0.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "icon": "./assets/subscription-tracker-icon.png",
    "scheme": "subscriptiontracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/subscription-tracker-icon.png",
      "bundleIdentifier": "com.markmccoid.subscription-tracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/subscription-tracker-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F59A0A",
          "image": "./assets/subscription-tracker-splash.png",
          "enableFullScreenImage_legacy": true,
          "resizeMode": "cover"
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
